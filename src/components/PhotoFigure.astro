---
// Une photo légendée dans le fil de l'accueil (ex. le cimetière dans « Un lieu chargé d'histoire »).
import { hasImage } from "../lib/images";

interface Props { src: string; alt: string; caption?: string; href?: string }
const { src, alt, caption, href } = Astro.props;
const Tag = href ? "a" : "div";
---
{hasImage(src) && (
  <figure class="pf">
    <Tag href={href} class="pf-frame"><img src={src} alt={alt} loading="lazy" /></Tag>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

<style>
  .pf { margin: 6px 0 14px; display: grid; gap: 8px; }
  .pf-frame { display: block; aspect-ratio: 16 / 9; border-radius: var(--r, 12px); overflow: hidden; }
  .pf img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  a.pf-frame:hover img { transform: scale(1.02); }
  .pf figcaption { color: var(--muted, #5b6b62); font-size: .88rem; }
</style>
