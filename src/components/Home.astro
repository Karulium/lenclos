---
import Base from "../layouts/Base.astro";
import BookingCard from "./BookingCard.astro";
import HouseRooms from "./HouseRooms.astro";
import PhotoFigure from "./PhotoFigure.astro";
import AmenityIcon from "./AmenityIcon.astro";
import site from "../data/site.json";
import pages from "../data/pages.json";
import maison from "../data/maison.json";
import autour from "../data/autour.json";
import faq from "../data/faq.json";
import { ui, routes, type Lang } from "../i18n/ui";
import { rich, plain } from "../lib/text";
import { hasImage } from "../lib/images";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const p = pages.home[lang];
const hist = pages.history[lang];

// Photos principales : public/img/photo1.jpg à photo5.jpg
const photos = [1, 2, 3, 4, 5].map((n) => ({ src: `/img/photo${n}.jpg`, ok: hasImage(`img/photo${n}.jpg`) }));

const ld = {
  "@context": "https://schema.org",
  "@type": "VacationRental",
  name: site.name,
  description: plain(p.metaDescription),
  address: { "@type": "PostalAddress", streetAddress: "186 route de Grand-Croix", postalCode: "97119", addressLocality: "Vieux-Habitants", addressRegion: "Guadeloupe", addressCountry: "FR" },
  geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng },
  telephone: site.whatsapp,
  containsPlace: { "@type": "Accommodation", additionalType: "EntirePlace", numberOfBedrooms: 2, numberOfBathroomsTotal: 2, occupancy: { "@type": "QuantitativeValue", maxValue: 5 }, floorSize: { "@type": "QuantitativeValue", value: 114, unitCode: "MTK" } },
  aggregateRating: { "@type": "AggregateRating", ratingValue: site.rating.airbnb.replace(",", "."), bestRating: 5, ratingCount: site.rating.airbnbCount },
};
---
<Base lang={lang} route="home" title={p.metaTitle} description={p.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <main id="top">
    <div class="hero-photo">
      <img src="/img/hero-2400.jpg" srcset="/img/hero-1200.jpg 1200w, /img/hero-2400.jpg 2400w" sizes="100vw" width="2400" height="1166" alt={t.heroAlt} fetchpriority="high" />
      <div class="wrap hero-over">
        <span class="eyebrow">{p.eyebrow}</span>
        <h1>{p.title}</h1>
      </div>
    </div>
    <div class="wrap hero">
      <div class="hero-head">
        <p class="hero-sub">{p.intro}</p>
        <ul class="facts">
          <li><span class="star">★</span><b>{site.rating.airbnb}</b> <span>{site.rating.airbnbCount} {t.facts.reviews}</span></li>
          <li><b>5</b> <span>{t.facts.guests}</span></li>
          <li><b>2</b> <span>{t.facts.rooms}</span></li>
          <li><b>2</b> <span>{t.facts.baths}</span></li>
          <li><b>114</b> m²</li>
        </ul>
      </div>
      <div class="mosaic" aria-label="Photos">
        {photos.map((ph, i) => (
          <figure class:list={["ph", { empty: !ph.ok }]} data-label={t.photoSoon}>
            {ph.ok && <img src={ph.src} alt={i === 0 ? t.captionGallery : ""} loading={i === 0 ? "eager" : "lazy"} />}
            {i === 0 && ph.ok && <figcaption>{t.captionGallery}</figcaption>}
          </figure>
        ))}
      </div>
    </div>

    <div class="wrap main">
      <div class="story">
        <section id="direct">
          <span class="eyebrow">{p.directEyebrow}</span>
          <h2>{p.directTitle}</h2>
          <div class="direct">
            {p.direct.map((d) => <div><strong>{d.big}</strong><span>{d.text}</span></div>)}
          </div>
        </section>

        <section id="maison">
          <span class="eyebrow">{p.houseEyebrow}</span>
          <h2>{p.houseTitle}</h2>
          <p class="lead">{p.houseText}</p>
          <HouseRooms lang={lang} />
          <a class="more" href={routes.garden[lang]}>{t.gardenLink}</a>
          <ul class="amen">
            {maison.amenities.map((a) => <li><AmenityIcon name={a.icon} /><span set:html={rich(a[lang])} /></li>)}
          </ul>
        </section>

        <section id="autour">
          <span class="eyebrow">{p.aroundEyebrow}</span>
          <h2>{p.aroundTitle}</h2>
          <p>{p.aroundText}</p>
          <div class="tabs" role="tablist" aria-label={t.navAround}>
            {autour.tabs.map((tab, i) => (
              <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? "true" : "false"}>{tab[lang]}</button>
            ))}
          </div>
          {autour.tabs.map((tab, i) => (
            <ul class="around" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={i !== 0}>
              {tab.places.map((pl) => (
                <li>
                  <b set:html={rich(pl[lang].name)} />
                  <small set:html={rich(pl[lang].text)} />
                  <em set:html={rich(pl[lang].where)} />
                  {pl.mapsQuery && (
                    <a class="go" target="_blank" rel="noopener" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(pl.mapsQuery)}`}>{t.mapLink}</a>
                  )}
                </li>
              ))}
            </ul>
          ))}
          <a class="mapcard" href={routes.map[lang]}>
            <strong>{t.mapTitle}</strong>
            <span>{t.mapText}</span>
            <span class="btn">{t.mapPageLink}</span>
          </a>
        </section>

        <section id="patrimoine">
          <span class="eyebrow">{p.heritageEyebrow}</span>
          <h2>{p.heritageTitle}</h2>
          <PhotoFigure src={hist.heroImage.src} alt={hist.heroImage.alt} caption={hist.heroImage.caption} href={routes.history[lang]} />
          <p>{p.heritageText}</p>
          <a class="more" href={routes.history[lang]}>{t.historyLink}</a>
        </section>

        <section id="avis">
          <span class="eyebrow">{p.reviewsEyebrow}</span>
          <div class="platforms">
            <div class="platform">
              <h2 class="pf-score"><span class="star">★</span> {site.rating.airbnb}<small>/5</small></h2>
              <p class="muted pf-name">Airbnb · {t.reviewCount(site.rating.airbnbCount)}</p>
              <div class="scores">
                {site.scores.map((s) => (
                  <div class="score"><div><span>{s[lang]}</span><b>{lang === "fr" ? String(s.value).replace(".", ",") : s.value}</b></div><div class="bar"><i style={`width:${(s.value / 5) * 100}%`}></i></div></div>
                ))}
              </div>
              <a class="more" href={site.rating.airbnbUrl} target="_blank" rel="noopener">{t.readReviews}</a>
            </div>
            <div class="platform">
              <h2 class="pf-score"><span class="star">★</span> {site.rating.booking}<small>/10</small></h2>
              <p class="muted pf-name">Booking.com · {t.reviewCount(site.rating.bookingCount)}</p>
              <div class="scores">
                {site.bookingScores.map((s) => (
                  <div class="score"><div><span>{s[lang]}</span><b>{(s.value < 10 ? s.value.toFixed(1) : String(s.value)).replace(".", lang === "fr" ? "," : ".")}</b></div><div class="bar"><i style={`width:${(s.value / 10) * 100}%`}></i></div></div>
                ))}
              </div>
              <a class="more" href={site.rating.bookingUrl} target="_blank" rel="noopener">{t.readReviews}</a>
            </div>
          </div>
          <div class="quotes">
            {site.reviews.map((r) => (
              <figure class="quote">
                <blockquote lang={lang === "en" ? "en" : "fr"}><p>{lang === "fr" ? `« ${r[lang].text} »` : `“${r[lang].text}”`}</p></blockquote>
                <figcaption><strong>{r.name}</strong> · {r[lang].country} · {r.source}{lang === "en" && <span class="muted"> · {t.translated}</span>}</figcaption>
              </figure>
            ))}
          </div>
          <p>{t.tripcomAlso(site.rating.tripcom, site.rating.tripcomCount)} {p.reviewsText}</p>
        </section>

        <section id="faq">
          <span class="eyebrow">FAQ</span>
          <h2>{p.faqTitle}</h2>
          <div>
            {faq.items.map((f) => (
              <details><summary>{f[lang].q}</summary><p set:html={rich(f[lang].a)} /></details>
            ))}
          </div>
        </section>
      </div>

      <BookingCard lang={lang} />
    </div>
  </main>
</Base>

<script>
  // Onglets de la rubrique « Autour »
  const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  tabs.forEach((tab) => tab.addEventListener("click", () => {
    tabs.forEach((o) => {
      o.setAttribute("aria-selected", String(o === tab));
      document.getElementById(o.getAttribute("aria-controls")!)!.hidden = o !== tab;
    });
  }));
</script>

