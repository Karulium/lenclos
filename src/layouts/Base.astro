---
import "../styles/global.css";
import site from "../data/site.json";
import { ui, routes, languages, type Lang, type RouteKey } from "../i18n/ui";
import { rich } from "../lib/text";

interface Props { lang: Lang; route: RouteKey; title: string; description: string; immersive?: boolean }
// immersive : page plein écran (En images), sans en-tête ni pied de page classiques.
const { lang, route, title, description, immersive = false } = Astro.props;
const t = ui[lang];
const home = routes.home[lang];
const canonical = new URL(routes[route][lang], Astro.site);
const otherLangs = (Object.keys(languages) as Lang[]);
const company = site.company;
const navLinks = [
  { href: `${home}#maison`, label: t.navHouse },
  { href: `${home}#autour`, label: t.navAround },
  { href: routes.map[lang], label: t.navMap },
  { href: `${home}#avis`, label: t.navReviews },
  { href: routes.garden[lang], label: t.navGarden },
  { href: routes.history[lang], label: t.navHistory },
  { href: routes.moments[lang], label: t.navMoments },
  { href: `${home}#faq`, label: t.navFaq },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {otherLangs.map((l) => <link rel="alternate" hreflang={l} href={new URL(routes[route][l], Astro.site)}>)}
  <link rel="alternate" hreflang="x-default" href={new URL(routes[route].fr, Astro.site)}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap">
  <slot name="head" />
</head>
<body class={immersive ? "immersive" : undefined}>
  {!immersive && <header class="top">
    <div class="wrap">
      <a class="brand" href={home}>L'Enclos <span>de Vieux-Habitants</span></a>
      <nav class="nav">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="lang" role="group" aria-label={t.langLabel}>
        {otherLangs.map((l) => (
          <a href={routes[route][l]} hreflang={l} lang={l} aria-current={l === lang ? "true" : "false"}>{l.toUpperCase()}</a>
        ))}
      </div>
      <a class="btn" href={`${home}#reserver`}>{t.book}</a>
      <details class="menu-m">
        <summary aria-label={t.menu}><span aria-hidden="true"></span></summary>
        <div class="menu-panel">
          <nav>
            {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          </nav>
          <div class="lang" role="group" aria-label={t.langLabel}>
            {otherLangs.map((l) => (
              <a href={routes[route][l]} hreflang={l} lang={l} aria-current={l === lang ? "true" : "false"}>{languages[l]}</a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </header>}

  <slot />

  {!immersive && <footer>
    <div class="wrap">
      <span>{site.name} · {site.address}</span>
      <span class="credit">
        {t.offeredBy}{" "}
        {company.url ? <a href={company.url}><strong>{company.name}</strong></a> : <strong>{company.name}</strong>}
        {company.legal && <> · <Fragment set:html={rich(company.legal)} /></>}
      </span>
      <span>{t.registration} <Fragment set:html={rich(site.registrationNumber)} /></span>
    </div>
  </footer>}
  <script>
    // Menu mobile : se referme quand on choisit une rubrique ou qu'on touche ailleurs.
    const menu = document.querySelector<HTMLDetailsElement>(".menu-m");
    if (menu) {
      menu.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) menu.open = false; });
      document.addEventListener("click", (e) => { if (!menu.contains(e.target as Node)) menu.open = false; });
    }
  </script>
</body>
</html>
